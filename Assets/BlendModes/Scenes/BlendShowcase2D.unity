  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>How it works:</b> Hue swaps every color for green but keeps how bright
    and how vivid it was, so the poisoned knight stays readable. Soft light is a
    gentle tint: it pushes colors toward icy blue or fire orange without flattening
    the shading.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
