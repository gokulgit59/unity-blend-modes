  m_Name: 
  m_EditorClassIdentifier: BlendMode.Showcase::BlendMode.Showcase.S06_HitFlashStation
  title: Hit flash
  caption: When the knight is hit, a white copy of it is added on top for a split
    second. Add brightens every color toward white, so the knight lights up, then
    fades back.
  formula: 'Linear dodge (Add): b + s, with s fading from white to black in 0.3 s.
    Fixed-function.'
  blendOn: 1
  opacity: 0.6
  statusLabel: {fileID: 651024428}
  fixedShader: {fileID: 4800000, guid: 6abab2704f20cb34aa40c3ccf6589f22, type: 3}
