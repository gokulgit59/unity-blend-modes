  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: <b>How it works:</b> Two ripple textures slide over the pond in different
    directions. They are mostly 50% gray, which Soft light ignores, so only their
    bright lines show, as moving glints. They are clipped to the pond so the grass
    stays still.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
