  m_Name: 
  m_EditorClassIdentifier: BlendMode.Showcase::BlendMode.Showcase.S16_UIStation
  title: UI shine and states
  caption: Real UI buttons with blend modes, set per Image like in Figma. Screen
    makes the sweeping shine, Multiply darkens a pressed button, Saturation grays
    out a disabled one, and Add makes a rare item glow.
  formula: 'Screen, Multiply, Add: UIBlendImage on a UI Image (Fixed-function). 
    Saturation: BlendLayerStack into a RawImage (Compositor).'
  blendOn: 1
  opacity: 1
