  m_Name: 
  m_EditorClassIdentifier: BlendMode.Showcase::BlendMode.Showcase.S10_StatusEffectsStation
  title: Status effects
  caption: 'Hue swaps every color for green but keeps how bright and how vivid it
    was, so the poisoned knight stays readable. Soft light is a gentle tint: it pushes
    colors toward icy blue or fire orange without flattening the shading.'
  formula: 'Hue: SetLum(SetSat(s, Sat(b)), Lum(b)).  Soft light: W3C soft light curve.
    Compositor, clipped to the character.'
  blendOn: 1
  opacity: 1
  statusLabel: {fileID: 1072632791}
