  m_Script: {fileID: 11500000, guid: 82ee7ffa91d8d6f43a3cd97b0e0d1a4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: BlendMode.Showcase::BlendMode.Showcase.S12_TextureDetailStation
  title: Texture detail
  caption: The texture is gray around 50%, which both modes treat as 'no change'.
    Lighter spots brighten the stone and darker cracks darken it. Overlay is punchy
    and contrasty; Soft light does the same thing more gently.
  formula: 'Overlay: b <= 0.5 ? 2bs : 1 - 2(1 - b)(1 - s).  Soft light: W3C soft
    light curve. Compositor.'
  blendOn: 1
  opacity: 1
  statusLabel: {fileID: 1853444407}
  fixedShader: {fileID: 4800000, guid: 6abab2704f20cb34aa40c3ccf6589f22, type: 3}
  compositorShader: {fileID: 4800000, guid: ed0c01ab016bc5346825018878165e75, type: 3}
