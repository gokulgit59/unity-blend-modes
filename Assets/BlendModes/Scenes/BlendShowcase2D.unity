  m_Script: {fileID: 11500000, guid: 72d7c0b433cf82c44a57e27b5e0e6905, type: 3}
  m_Name: 
  m_EditorClassIdentifier: BlendMode.Showcase::BlendMode.Showcase.S08_GlitchStation
  title: Glitch
  caption: Both bars subtract colors from what is under them, so bright areas flip
    to dark and dark ones light up. Difference gives pure black where the two match.
    Exclusion is a softer, grayer version of the same idea.
  formula: 'Difference: |b - s|, Compositor (upper bar).   Exclusion: b + s - 2bs,
    Fixed-function (lower bar).'
  blendOn: 1
  opacity: 1
  statusLabel: {fileID: 1095877099}
  fixedShader: {fileID: 4800000, guid: 6abab2704f20cb34aa40c3ccf6589f22, type: 3}
  compositorShader: {fileID: 4800000, guid: ed0c01ab016bc5346825018878165e75, type: 3}
  demoArea:
    serializedVersion: 2
    x: -8.6
    y: -4.3
    width: 17.2
    height: 7.1
  animateToggle: {fileID: 610045890}
  animate: 1
