  m_Script: {fileID: 11500000, guid: 7daf1337791827a41831c49c1ccc81df, type: 3}
  m_Name: 
  m_EditorClassIdentifier: BlendMode.Showcase::BlendMode.Showcase.S07_DissolveStation
  title: Dissolve
  caption: Dissolve does not mix colors. Each pixel is either fully the character
    or fully the background, picked at random, and the opacity sets the odds. Lower
    it and the character breaks apart into specks.
  formula: 'Dissolve: noise(pixel) < opacity ? s : b. Compositor.'
  blendOn: 1
  opacity: 1
  statusLabel: {fileID: 1014148664}
  fixedShader: {fileID: 4800000, guid: 6abab2704f20cb34aa40c3ccf6589f22, type: 3}
  compositorShader: {fileID: 4800000, guid: ed0c01ab016bc5346825018878165e75, type: 3}
  demoArea:
    serializedVersion: 2
    x: -8.6
    y: -4.3
    width: 17.2
    height: 7.1
  animateToggle: {fileID: 2106640053}
  animate: 1
